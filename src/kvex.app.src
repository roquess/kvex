{application, kvex, [
    {description, "Approximate k-NN vector search with bundled sied SIMD NIF"},
    {vsn, "0.2.4"},
    {registered, [kvex_sup]},
    {mod, {kvex_app, []}},
    {applications, [kernel, stdlib]},
    {env, []},
    {modules, []},

    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/roquess/kvex"}]},
    {maintainers, ["Steve Roques <steve@roques.me>"]},

    {files, [
        "src/**",
        "native/**",
        "priv/sied.dll",
        "priv/sied.so",
        "priv/sied.dylib",
        "Makefile",
        "rebar.config",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ]}
]}.
